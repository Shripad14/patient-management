<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!-- Spring Boot -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <!-- Project Information -->
    <groupId>org.pm</groupId>
    <artifactId>billing-service</artifactId>
    <version>0.0.1-SNAPSHOT</version>

    <name>billing-service</name>
    <description>Billing Service</description>

    <!-- Java -->
    <properties>
        <java.version>21</java.version>
    </properties>

    <!-- ====================================================== -->
    <!-- DEPENDENCIES -->
    <!-- ====================================================== -->

    <dependencies>

        <!-- REST API / Spring MVC / Embedded Tomcat / Jackson -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>


        <!-- ================================================== -->
        <!-- gRPC SERVER -->
        <!-- ================================================== -->

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-grpc-server</artifactId>
        </dependency>


        <!-- ================================================== -->
        <!-- gRPC CLIENT -->
        <!-- Uncomment this if Billing Service calls another
             service through gRPC -->
        <!-- ================================================== -->

        <!--
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-grpc-client</artifactId>
        </dependency>
        -->


        <!-- ================================================== -->
        <!-- gRPC / Protobuf -->
        <!-- Versions are managed by Spring Boot -->
        <!-- ================================================== -->

        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-protobuf</artifactId>
        </dependency>

        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-stub</artifactId>
        </dependency>


        <!-- ================================================== -->
        <!-- Optional:
             Only add this if you specifically need Netty Shaded.
             Spring Boot's gRPC server starter already provides
             the normal gRPC transport. -->
        <!-- ================================================== -->

        <!--
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-netty-shaded</artifactId>
        </dependency>
        -->

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>


    </dependencies>


    <!-- ====================================================== -->
    <!-- BUILD -->
    <!-- ====================================================== -->

    <build>

        <plugins>

            <!-- ================================================== -->
            <!-- Spring Boot -->
            <!-- ================================================== -->

            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>


            <!-- ================================================== -->
            <!-- Protobuf + gRPC Code Generation -->
            <!-- ================================================== -->

            <plugin>
                <groupId>io.github.ascopes</groupId>
                <artifactId>protobuf-maven-plugin</artifactId>
            </plugin>

        </plugins>

    </build>

</project>